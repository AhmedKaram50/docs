{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "mab-api",
  "description": "Mobile-App-Builder API — DDD-structured Fastify backend powering the mab product.",
  "colors": {
    "primary": "#0EA5E9",
    "light": "#38BDF8",
    "dark": "#0369A1"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "getting-started/installation",
              "getting-started/environment",
              "getting-started/running-locally"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "architecture/overview",
              "architecture/module-structure",
              "architecture/auth-and-tenancy",
              "architecture/error-handling"
            ]
          }
        ]
      },
      {
        "tab": "Identity Module",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "modules/identity/overview",
              "modules/identity/concepts"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "modules/identity/auth",
              "modules/identity/shopify-install-flow",
              "modules/identity/shops",
              "modules/identity/team",
              "modules/identity/subscription"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "modules/identity/errors"
            ]
          }
        ]
      },
      {
        "tab": "References",
        "groups": [
          {
            "group": "Notes",
            "pages": [
              "references/index"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/AhmedKaram50",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "API repo",
        "href": "https://github.com/AhmedKaram50"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {}
  }
